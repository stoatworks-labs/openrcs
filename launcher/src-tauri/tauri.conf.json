{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openRCS",
  "version": "0.8.2",
  "identifier": "com.allansargeant.openrcs",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "openRCS",
        "width": 460,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "shortDescription": "Control surface for Analog Way processors",
    "longDescription": "openRCS drives Analog Way LiveCore, Midra, PLS300, LivePremier, Midra 4K and Alta 4K processors from a browser. This tray app runs the bundled openrcs-server on your own machine and opens the control surface; the command-line packages from the same release are the shape for a box in the rack.",
    "homepage": "https://github.com/stoatworks-labs/openrcs",
    "resources": [
      "launcher.toml",
      "bin/openrcs-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
